---
import DomainName from './DomainName.astro';
import Label from './Label.astro';

interface Props {
  domain: string;
  description: string;
  languages: string[];
  status: 'live' | 'building';
  url: string;
  tags: string[];
}
const { domain, description, languages, status, url, tags } = Astro.props;
const langLabel: Record<string, string> = {
  sv: 'SV', da: 'DA', no: 'NO', nl: 'NL', en: 'EN', multi: 'Flera språk',
};
---
<a
  href={url}
  target="_blank"
  rel="noopener"
  class="sitecard"
  aria-label={`${domain} — öppnar i ny flik`}
  data-tags={tags.join(',')}
>
  <div class="sitecard__header">
    <DomainName domain={domain} size="md" />
    {status === 'building' && (
      <span class="sitecard__building">Under uppbyggnad</span>
    )}
  </div>
  <p class="sitecard__desc">{description}</p>
  <div class="sitecard__langs">
    {languages.map(lang => (
      <span class="sitecard__lang">{langLabel[lang] ?? lang.toUpperCase()}</span>
    ))}
  </div>
</a>

<style>
.sitecard {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 24px;
  background: var(--color-surface);
  border: 1px solid var(--color-border-ui);
  border-radius: var(--radius-card);
  text-decoration: none;
  color: inherit;
  transition: border-color 0.15s;
}
.sitecard:hover { border-color: var(--color-ink); }
.sitecard:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.sitecard__header {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.sitecard__building {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted);
  background: var(--color-line);
  padding: 2px 8px;
  border-radius: 4px;
}

.sitecard__desc {
  font-size: 15px;
  color: var(--color-ink-soft);
  line-height: 1.5;
  flex-grow: 1;
}

.sitecard__langs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.sitecard__lang {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-muted);
}
</style>
