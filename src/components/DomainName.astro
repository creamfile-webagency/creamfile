---
interface Props {
  domain: string;
  size?: 'sm' | 'md' | 'lg';
  dark?: boolean;
}
const { domain, size = 'md', dark = false } = Astro.props;
const lastDot = domain.lastIndexOf('.');
const name = lastDot >= 0 ? domain.slice(0, lastDot) : domain;
const tld = lastDot >= 0 ? domain.slice(lastDot) : '';
---
<span class:list={['domain', `domain--${size}`, { 'domain--dark': dark }]}>
  {name}<span class="domain__dot">{tld}</span>
</span>

<style>
.domain {
  font-family: var(--font-display);
  font-weight: 500;
  letter-spacing: -0.01em;
  font-variation-settings: "opsz" 48, "SOFT" 0;
}
.domain--sm { font-size: 18px; line-height: 1.4; }
.domain--md { font-size: 22px; line-height: 1.4; }
.domain--lg { font-size: 28px; line-height: 1.3; }

.domain__dot { color: var(--color-accent); }
.domain--dark .domain__dot { color: var(--color-honey); }
.domain--dark { color: #FBF8F2; }
</style>
