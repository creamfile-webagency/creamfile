---
interface Props {
  number: string;
  title: string;
  description: string;
  price: string;
  href: string;
}
const { number, title, description, price, href } = Astro.props;
---
<div class="offercard">
  <span class="offercard__num">{number}</span>
  <h3 class="offercard__title">{title}</h3>
  <p class="offercard__desc">{description}</p>
  <div class="offercard__footer">
    <span class="offercard__price">{price}</span>
    <a href={href} class="offercard__link">Läs mer →</a>
  </div>
</div>

<style>
.offercard {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 36px;
  border: 1px solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

.offercard__num {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 40px;
  line-height: 1;
  color: var(--color-accent);
  font-variation-settings: "opsz" 144, "SOFT" 50;
  font-variant-numeric: tabular-nums;
}

.offercard__title {
  font-size: 24px;
  line-height: 1.3;
}

.offercard__desc {
  color: var(--color-ink-soft);
  flex-grow: 1;
  font-size: 16px;
  line-height: 1.6;
}

.offercard__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16px;
  border-top: 1px solid var(--color-line);
}

.offercard__price {
  font-weight: 600;
  font-size: 15px;
  color: var(--color-ink);
}

.offercard__link {
  font-weight: 600;
  font-size: 15px;
  color: var(--color-accent);
  text-decoration: none;
}
.offercard__link:hover { color: var(--color-accent-dk); }
</style>
