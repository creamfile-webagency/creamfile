---
interface Props {
  text?: string;
  class?: string;
  dark?: boolean;
}
const { text, class: className = '', dark = false } = Astro.props;
---
<span class:list={['label', className, { 'label--dark': dark }]}>
  {text ?? <slot />}
</span>

<style>
.label {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
}
.label--dark {
  color: var(--color-honey);
}
</style>
