---
import DomainName from './DomainName.astro';

interface Props {
  groupName: string;
  groupId: string;
  domains: string[];
  count: number;
}
const { groupName, groupId, domains, count } = Astro.props;
---
<div class="domainlist">
  <div class="domainlist__meta">
    <span class="domainlist__label">{groupName}</span>
    <span class="domainlist__count">{count} sajter</span>
  </div>
  <div class="domainlist__domains">
    {domains.map(domain => (
      <DomainName domain={domain} size="md" dark />
    ))}
  </div>
</div>

<style>
.domainlist {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  padding: 32px 0;
  border-top: 1px solid rgba(251, 248, 242, 0.16);
}
@media (min-width: 640px) {
  .domainlist {
    grid-template-columns: 200px 1fr;
    align-items: start;
  }
}

.domainlist__meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.domainlist__label {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-honey);
}

.domainlist__count {
  font-size: 14px;
  color: rgba(251, 248, 242, 0.6);
}

.domainlist__domains {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 28px;
}
</style>
