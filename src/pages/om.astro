---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import { site } from '../data/site';
import { groups } from '../data/sites';
---
<Base
  title="Om Creamfile"
  description="Creamfile är ett litet svenskt bolag som äger och bygger starka webbadresser sedan 2004. Egna domäner, egen kod, egna sajter."
  canonical="https://creamfile.com/om"
>

  <!-- Hero -->
  <section class="om-hero container">
    <div class="om-hero__label">
      <Label text="Om Creamfile" />
    </div>
    <div class="om-hero__grid">
      <div class="om-hero__left">
        <h1 class="om-hero__h1">Gräddfil på nätet, sedan 2004.</h1>
      </div>
      <div class="om-hero__right">
        <p>Creamfile är engelska för gräddfil. Våra adresser är den snabba vägen till det folk söker — och för företag den snabba vägen till kunder som redan letar.</p>
        <p>Idén bakom är enkel: en stark webbadress är den enda marknadsföringstillgång som aldrig kan kopieras. Sedan 2004 har vi samlat Sveriges bästa adresser och byggt dem till sajter som människor faktiskt använder.</p>
        <p>Vi är inte en webbyrå — vi bygger för egen räkning. Vi är inte ett annonsnätverk — vi säljer bara egna ytor. Och vi är inte domänhandlare — vi köper adresser för att bygga på dem, inte för att sälja dem vidare.</p>
        <p>Det vi är, är ett litet svenskt bolag som äger restaurang.com, hotellet.se, bröllop.se, elen.se, aktie.se och ett fyrtiotal andra starka adresser — och som tänker i decennier, inte kvartal.</p>
      </div>
    </div>
  </section>

  <!-- Dark motor section -->
  <section class="motor-section" aria-label="Affärsområden">
    <div class="motor-section__inner container">
      <div class="motor-section__left">
        <Label text="Så bygger vi" dark />
        <h2 class="motor-section__h2">En motor, många adresser.</h2>
        <p class="motor-section__p">Våra sajter byggs inte en och en. Portföljen är ordnad i sex affärsområden, och inom varje område bygger vi mot en gemensam motor — så när en produkt fungerar på en adress kan den slås på hos nästa.</p>
      </div>
      <div class="motor-section__grid">
        {groups.map(g => (
          <div class="motor-item">
            <span class="motor-item__name">{g.name}</span>
            <span class="motor-item__tagline">{g.tagline}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core values -->
  <section class="values container" aria-label="Kärnvärden">
    <div class="values__grid">
      {[
        { title: 'Självklarhet', text: 'Vi väljer adresser som är det uppenbara svaret på en fråga. Behöver det förklaras är det fel adress.' },
        { title: 'Nytta före räckvidd', text: 'Sajterna byggs för att lösa besökarens uppgift. Trafik och intäkter är följden, aldrig målet.' },
        { title: 'Ägande', text: 'Egna domäner, egen kod, egen data, egen publik. Vi hyr inte räckvidd av någon annans algoritm.' },
        { title: 'Långsiktighet', text: 'Bröllop.se sedan 2004. Vi säger nej till snabba pengar som skadar en adress.' },
      ].map(v => (
        <div class="value">
          <h3 class="value__title">{v.title}</h3>
          <p class="value__text">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact card -->
  <section class="contact-card container">
    <div class="contact-card__inner">
      <div class="contact-card__header">
        <Label text="Kontakt" />
        <h2 class="contact-card__h2">{site.name}</h2>
      </div>
      <div class="contact-card__details">
        <div class="contact-detail">
          <Label text="E-post" />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="contact-detail">
          <Label text="Org.nr" />
          <span>{site.orgNr}</span>
        </div>
        <div class="contact-detail">
          <Label text="Adress" />
          <span>{site.address}</span>
        </div>
        <div class="contact-detail">
          <Label text="Annonsförfrågningar" />
          <a href="/annonsera">Annonsera →</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
.om-hero {
  padding: 80px 0 72px;
}
@media (min-width: 1024px) { .om-hero { padding: 96px 0 96px; } }

.om-hero__label { margin-bottom: 24px; }

.om-hero__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}
@media (min-width: 1024px) {
  .om-hero__grid { grid-template-columns: 5fr 6fr; gap: 64px; }
}

.om-hero__h1 {
  font-size: clamp(40px, 5vw, 64px);
  line-height: 1.05;
}

.om-hero__right {
  display: flex;
  flex-direction: column;
  gap: 24px;
  font-size: 19px;
  line-height: 1.6;
  color: var(--color-ink-soft);
}

/* Motor section */
.motor-section {
  background: var(--color-ink);
  color: #FBF8F2;
  border-radius: var(--radius-card);
  margin: 0 20px 80px;
  padding: 56px 40px;
}
@media (min-width: 1024px) {
  .motor-section { margin: 0 64px 96px; padding: 64px; }
}

.motor-section__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  max-width: none;
  padding: 0;
  margin: 0;
}
@media (min-width: 1024px) {
  .motor-section__inner { grid-template-columns: 5fr 6fr; gap: 64px; align-items: start; }
}

.motor-section__left {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.motor-section__h2 {
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.12;
  color: #FBF8F2;
}

.motor-section__p {
  color: rgba(251, 248, 242, 0.72);
}

.motor-section__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}
@media (min-width: 640px) {
  .motor-section__grid { grid-template-columns: repeat(2, 1fr); gap: 0 24px; }
}

.motor-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 16px 0;
  border-top: 1px solid rgba(251, 248, 242, 0.16);
}

.motor-item__name {
  font-family: var(--font-display);
  font-size: 20px;
  color: #FBF8F2;
  font-weight: 500;
  font-variation-settings: "opsz" 48, "SOFT" 0;
}

.motor-item__tagline {
  font-size: 14px;
  color: rgba(251, 248, 242, 0.6);
}

/* Values */
.values {
  padding-bottom: 96px;
}

.values__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}
@media (min-width: 640px) {
  .values__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .values__grid { grid-template-columns: repeat(4, 1fr); }
}

.value {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 32px;
  border-top: 2px solid var(--color-ink);
}

.value__title {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
}

.value__text {
  font-size: 15px;
  color: var(--color-ink-soft);
}

/* Contact card */
.contact-card {
  padding-bottom: 96px;
}

.contact-card__inner {
  padding: 48px 40px;
  border: 1px solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}
@media (min-width: 1024px) {
  .contact-card__inner { grid-template-columns: 5fr 6fr; gap: 64px; padding: 64px; }
}

.contact-card__header {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.contact-card__h2 {
  font-size: clamp(28px, 3vw, 36px);
  line-height: 1.15;
}

.contact-card__details {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.contact-detail {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 16px;
}
</style>
